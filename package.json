{
  "name": "nvelope-core",
  "version": "1.1.0",
  "description": "TypeScript library implementing the Nostr-Mail protocol for nVelope clients",
  "license": "MIT",
  "author": "Steven Day",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsup src/index.ts --format esm,cjs --dts --clean",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "format": "prettier --write .",
    "check": "npm run typecheck && npm run lint && npm test",
    "demo:offline": "tsx examples/demo-offline.ts",
    "demo:relay": "tsx examples/demo-relay.ts",
    "demo:setup": "tsx examples/demo-setup.ts",
    "docs": "typedoc --out docs/api --name nvelope-core src/index.ts",
    "prepublishOnly": "npm run build"
  },
  "keywords": [
    "nostr",
    "nostr-mail",
    "nvelope",
    "email",
    "encryption"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/StevenDay83/nvelope-core.git"
  },
  "dependencies": {
    "nostr-tools": "^2.19.4"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "eslint": "^9.17.0",
    "prettier": "^3.4.0",
    "tsup": "^8.3.0",
    "typescript": "^5.7.0",
    "typescript-eslint": "^8.18.0",
    "vitest": "^2.1.0",
    "tsx": "^4.19.0",
    "typedoc": "^0.27.0"
  }
}